# ─────────────────────────────────────────────────────────────
# Supabase (authentication + profiles/trade history)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# ─────────────────────────────────────────────────────────────
# Activepieces (Gmail email notifications)
# Webhook URL of the published "Aurum Email Notifications" flow
# ─────────────────────────────────────────────────────────────
ACTIVEPIECES_WEBHOOK_URL=https://cloud.activepieces.com/api/v1/webhooks/YOUR_FLOW_ID

# ─────────────────────────────────────────────────────────────
# Groq (OpenAI-compatible) — AI analysis & agent decisions.
# Optional: a local technical engine is used as a fallback when unset.
# Get a key at https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Public site URL — used for links inside notification emails.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
